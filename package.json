{
  "name": "pi-llama-swap",
  "version": "0.1.0",
  "description": "Pi extension for the local llama-swap provider (OpenAI-compatible).",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "llama-swap",
    "local",
    "llama.cpp"
