  "author": "ismael",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --skipLibCheck extensions/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2"
  }
}